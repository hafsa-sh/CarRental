@model List<CarRentalApplication.Models.Car>
@{
    ViewData["Title"] = "Available Cars";
}
<h2 class="mb-2">Available Cars</h2>
<p class="text-muted mb-4">Select a car to book it.</p>
@if (Model.Count == 0)
{
    <div class="alert alert-info">
        No cars are currently available.
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var car in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body d-flex flex-column">

                        <h5 class="card-title">@car.Name</h5>

                        <p class="card-text">
                            Price Per Day:
                            <strong>PKR @car.PricePerDay</strong>
                        </p>

                        <div class="mb-3">
                            <span class="badge bg-success">
                                Available
                            </span>
                        </div>

                        <form asp-controller="Cars"
                              asp-action="Book"
                              method="post"
                              class="mt-auto">

                            <input type="hidden"
                                   name="id"
                                   value="@car.Id" />

                            <button type="submit"
                                    class="btn btn-primary w-100">
                                Book Car
                            </button>

                        </form>

                    </div>
                </div>
            </div>
        }
    </div>
}

